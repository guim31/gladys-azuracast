            "fr": "Titre complet",
            "de": "Titel",
            "es": "Canción"
          }
        },
        {
          "key": "artist",
          "type": "string",
          "label": {
            "en": "Artist",
            "fr": "Artiste",
            "de": "Interpret",
            "es": "Artista"
          }
        },
        {
          "key": "title",
          "type": "string",
          "label": {
            "en": "Title",
            "fr": "Titre",
            "de": "Titel des Songs",
            "es": "Título"
          }
        },
        {
          "key": "album",
          "type": "string",
          "label": {
            "en": "Album",
            "fr": "Album",
            "de": "Album",
            "es": "Álbum"
          }
        }
