{
  "manifest_version": 1,
  "type": "device",
  "name": "AzuraCast",
  "description": {
    "en": "Your AzuraCast web radio in Gladys: song, listeners, live shows, and scenes on every change.",
    "fr": "Votre webradio AzuraCast dans Gladys : titre, auditeurs, directs, et des scènes à chaque changement.",
    "de": "Dein AzuraCast-Webradio in Gladys: Titel, Zuhörer, Live-Sendungen und Szenen bei jeder Änderung.",
    "es": "Su radio web AzuraCast en Gladys: canción, oyentes, directos y escenas en cada cambio."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-azuracast:1.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-azuracast/main/cover.png",
  "categories": ["multimedia"],
  "transports": ["local", "cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your AzuraCast",
        "fr": "Votre AzuraCast",
        "de": "Dein AzuraCast",
        "es": "Su AzuraCast"
      },
      "description": {
        "en": "Enter the address of your AzuraCast. Its stations appear in the Discover tab: add the ones you want. The API key is optional (Next song button and action).",
        "fr": "Saisissez l'adresse de votre AzuraCast. Ses stations apparaissent dans l'onglet Découverte : ajoutez celles que vous voulez. La clé d'API est facultative (bouton et action « Titre suivant »).",
        "de": "Gib die Adresse deines AzuraCast ein. Seine Sender erscheinen im Tab „Entdecken“: Füge die gewünschten hinzu. Der API-Schlüssel ist optional (Schaltfläche und Aktion „Nächster Titel“).",
        "es": "Introduzca la dirección de su AzuraCast. Sus emisoras aparecen en la pestaña Descubrir: añada las que desee. La clave de API es opcional (botón y acción «Siguiente canción»)."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-azuracast/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Einrichtungsanleitung",
            "es": "Guía de instalación"
          }
        },
        {
          "url": "https://www.azuracast.com/docs/developers/apis/",
          "label": {
            "en": "AzuraCast API",
            "fr": "API d'AzuraCast",
            "de": "AzuraCast-API",
            "es": "API de AzuraCast"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "AzuraCast address",
        "fr": "Adresse d'AzuraCast",
        "de": "AzuraCast-Adresse",
        "es": "Dirección de AzuraCast"
      },
      "description": {
        "en": "Address of the AzuraCast web interface.",
        "fr": "Adresse de l'interface web d'AzuraCast.",
        "de": "Adresse der AzuraCast-Weboberfläche.",
        "es": "Dirección de la interfaz web de AzuraCast."
      },
      "placeholder": {
        "en": "e.g. http://192.168.1.2",
        "fr": "ex. http://192.168.1.2",
        "de": "z. B. http://192.168.1.2",
        "es": "p. ej. http://192.168.1.2"
      },
      "required": true
    },
    {
      "key": "api_key",
      "type": "secret",
      "label": {
        "en": "API key (optional)",
        "fr": "Clé d'API (facultative)",
        "de": "API-Schlüssel (optional)",
        "es": "Clave de API (opcional)"
      },
      "description": {
        "en": "To skip to the next song: create it in AzuraCast, My Account → API Keys, with a user allowed to manage the station.",
        "fr": "Pour passer au titre suivant : créez-la dans AzuraCast, My Account → API Keys, avec un utilisateur autorisé à gérer la station.",
        "de": "Zum Weiterschalten auf den nächsten Titel: Erstelle ihn in AzuraCast unter My Account → API Keys, mit einem Benutzer, der den Sender verwalten darf.",
        "es": "Para pasar a la siguiente canción: créela en AzuraCast, My Account → API Keys, con un usuario autorizado a gestionar la emisora."
      },
      "required": false
    },
    {
      "key": "options",
      "type": "section",
      "label": {
        "en": "Options",
        "fr": "Options",
        "de": "Optionen",
        "es": "Opciones"
      }
    },
    {
      "key": "poll_interval",
      "type": "select",
      "label": {
        "en": "Refresh interval",
        "fr": "Intervalle de rafraîchissement",
        "de": "Aktualisierungsintervall",
        "es": "Intervalo de actualización"
      },
      "description": {
        "en": "How often AzuraCast is read: one light request for all the stations.",
        "fr": "À quelle fréquence AzuraCast est lu : une requête légère pour toutes les stations.",
        "de": "Wie oft AzuraCast gelesen wird: eine leichte Anfrage für alle Sender.",
        "es": "Con qué frecuencia se lee AzuraCast: una petición ligera para todas las emisoras."
      },
      "required": false,
      "default": "15",
      "options": [
        {
          "value": "10",
          "label": {
            "en": "10 seconds",
            "fr": "10 secondes",
            "de": "10 Sekunden",
            "es": "10 segundos"
          }
        },
        {
          "value": "15",
          "label": {
            "en": "15 seconds",
            "fr": "15 secondes",
            "de": "15 Sekunden",
            "es": "15 segundos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Language of the feature names (set when the device is added) and of the scene results.",
        "fr": "Langue des noms des fonctionnalités (fixés à l'ajout de l'appareil) et des résultats de scène.",
        "de": "Sprache der Funktionsnamen (beim Anlegen des Geräts festgelegt) und der Szenen-Ergebnisse.",
        "es": "Idioma de los nombres de las funciones (fijados al añadir el dispositivo) y de los resultados de escena."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "track_changed",
      "label": {
        "en": "A new song plays",
        "fr": "Un nouveau titre passe",
        "de": "Ein neuer Titel läuft",
        "es": "Suena una nueva canción"
      },
      "description": {
        "en": "The station plays another song (AutoDJ or live).",
        "fr": "La station passe un autre titre (AutoDJ ou direct).",
        "de": "Der Sender spielt einen anderen Titel (AutoDJ oder live).",
        "es": "La emisora reproduce otra canción (AutoDJ o directo)."
      },
      "fields": [
        {
          "key": "station",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Station",
            "fr": "Station",
            "de": "Sender",
            "es": "Emisora"
          },
          "required": false
        }
      ],
      "variables": [
        {
          "key": "station_name",
          "type": "string",
          "label": {
            "en": "Station name",
            "fr": "Nom de la station",
            "de": "Name des Senders",
            "es": "Nombre de la emisora"
          }
        },
        {
          "key": "text",
          "type": "string",
          "label": {
